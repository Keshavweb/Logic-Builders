    {
      "id": "order_api",
      "provider": "tool_http_request",
      "name": "HTTP Request",
      "config": {
        "allowDELETE": true,
        "allowGET": true,
        "allowHEAD": false,
        "allowOPTIONS": false,
        "allowPATCH": true,
        "allowPOST": true,
        "allowPUT": true,
        "maxConcurrentRequests": 5,
        "rateLimitPerMinute": 100,
        "rateLimitPerSecond": 10,
        "type": "tool_http_request",
        "urlWhitelist": [],
        "serverName": "order_api",
        "description": "Look up order details by transaction_id from the merchant's store database. Call with GET http://localhost:3001/api/mock/order?transaction_id={transaction_id}. Returns order_details, payment_info, delivery_address."
      },
      "ui": {
        "position": {
