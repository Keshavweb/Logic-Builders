    {
      "id": "submit_agent",
      "provider": "agent_rocketride",
      "name": "RocketRide Wave",
      "config": {
        "agent_description": "",
        "instructions": [
          "You are a chargeback submission processor. You receive an approved dispute dossier and must submit it.",
          "",
          "STEP 1: Parse the incoming JSON to extract: dispute_id, customer_id, dossier (the evidence package).",
          "",
          "STEP 2: Use stripe_submit to POST the evidence to the payment processor.",
          "Since Stripe is stubbed for this build, call the mock endpoint:",
          "POST http://localhost:3001/api/mock/stripe-submit",
          "Body: { \"dispute_id\": \"...\", \"evidence_letter\": \"...\", \"signals\": {...} }",
          "",
          "STEP 3: Log the submission attempt by returning a JSON response with:",
          "{",
          "  \"dispute_id\": \"...\",",
          "  \"submitted\": true,",
          "  \"submitted_at\": \"2026-08-31T12:00:00.000Z\",",
          "  \"processor_reference\": \"mock_ref_...\",",
          "  \"status\": \"evidence_submitted\"",
          "}",
          "",
          "If the submission fails, return:",
          "{",
          "  \"dispute_id\": \"...\",",
          "  \"submitted\": false,",
          "  \"error\": \"reason for failure\",",
          "  \"status\": \"submission_failed\"",
          "}",
          "",
          "Return ONLY valid JSON — no markdown, no backticks, no explanation text."
        ],
        "max_waves": 5,
        "require_tool_call": false,
        "parameters": {}
      },
      "ui": {
        "position": {
          "x": 460,
          "y": 200
        },
        "measured": {
          "width": 150,
          "height": 106
        },
        "nodeType": "default",
        "formDataValid": true
      },
      "input": [
        {
          "lane": "questions",
          "from": "question_1"
        }
      ]
    },
    {
      "id": "ollama_1",
      "provider": "llm_ollama",
      "name": "Ollama",
      "config": {
        "profile": "llama3.2",
        "llama3.2": {
          "model": "llama3.2",
          "host": "http://127.0.0.1:11434",
          "serverbase": "http://127.0.0.1:11434/v1"
        },
        "parameters": {}
      },
      "ui": {
        "position": {
          "x": 460,
          "y": 360
        },
        "measured": {
          "width": 150,
          "height": 68
        },
        "nodeType": "default",
        "formDataValid": true
      },
      "control": [
        {
          "classType": "llm",
          "from": "submit_agent"
        }
      ]
    },
    {
      "id": "memory_internal_1",
      "provider": "memory_internal",
      "name": "Memory (Internal)",
      "config": {
        "type": "memory_internal"
      },
      "ui": {
        "position": {
          "x": 460,
          "y": 460
        },
        "measured": {
          "width": 150,
          "height": 42
        },
        "nodeType": "default",
