          "from": "submit_agent"
        }
      ]
    },
    {
      "id": "stripe_submit",
      "provider": "tool_http_request",
      "name": "HTTP Request",
      "config": {
        "allowDELETE": true,
        "allowGET": true,
        "allowHEAD": false,
        "allowOPTIONS": false,
        "allowPATCH": true,
        "allowPOST": true,
        "allowPUT": true,
        "maxConcurrentRequests": 5,
        "rateLimitPerMinute": 100,
        "rateLimitPerSecond": 10,
        "type": "tool_http_request",
        "urlWhitelist": [],
        "serverName": "stripe_submit",
        "description": "Submit evidence to the payment processor (Stripe stub). POST to http://localhost:3001/api/mock/stripe-submit with JSON body containing dispute_id, evidence_letter, and signals. Returns a processor_reference on success."
      },
      "ui": {
        "position": {
          "x": 680,
          "y": 360
        },
        "measured": {
          "width": 150,
          "height": 42
        },
        "nodeType": "default",
        "formDataValid": true
      },
      "control": [
        {
          "classType": "tool",
          "from": "submit_agent"
        }
      ]
    },
    {
      "id": "submission_out",
      "provider": "response_answers",
      "name": "Return Answers",
      "config": {
        "laneName": "answers"
      },
      "ui": {
        "position": {
          "x": 700,
          "y": 200
        },
        "measured": {
          "width": 150,
          "height": 68
        },
        "nodeType": "default",
