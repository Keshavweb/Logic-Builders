{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "chargeback_evidence_v1",
  "title": "Chargeback Evidence Dossier",
  "description": "Reference shape for the dossier assembled by chargeback-defender-api (services/scoring.ts assembleDossier). Stored in the disputes.dossier JSONB column and consumed directly by the Review Queue UI. The RocketRide pipeline only contributes evidence_letter and evidence_analysis.confidenceExplanation; every other field is computed in the API from the mock backing-service lookups.",
  "type": "object",
  "required": [
    "confidence_score",
    "confidence_label",
    "missing_evidence",
    "customer_profile",
    "evidence_analysis",
    "evidence_letter"
  ],
  "properties": {
    "confidence_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "0-100 score from computeConfidence(); base 20 plus weighted favorable signals"
    },
    "confidence_label": {
      "type": "string",
      "maxLength": 40,
      "description": "strong case | moderate case | weak evidence | insufficient evidence"
    },
    "missing_evidence": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Evidence items that could not be gathered (failed lookups, absent photo/signature/address, etc.)"
    },
    "customer_profile": {
      "type": "object",
      "description": "camelCase — maps 1:1 to the UI CustomerProfile type",
      "required": [
        "orderDetails",
        "paymentInfo",
        "deliveryStatus",
        "deliveryTimestamp",
        "deliveryAddress",
        "ipAddress",
        "deviceMatch",
        "deliveryPhotoUrl",
        "signature",
        "priorHistory"
      ],
      "properties": {
        "orderDetails": { "type": ["string", "null"] },
        "paymentInfo": { "type": ["string", "null"] },
        "deliveryStatus": { "type": ["string", "null"] },
        "deliveryTimestamp": { "type": ["string", "null"] },
        "deliveryAddress": { "type": ["string", "null"] },
        "ipAddress": { "type": ["string", "null"] },
        "deviceMatch": { "enum": ["yes", "no", "unknown"] },
        "deliveryPhotoUrl": { "type": ["string", "null"] },
        "signature": { "type": ["string", "null"] },
        "priorHistory": {
          "type": "object",
          "required": ["count", "outcomes"],
          "properties": {
            "count": { "type": "integer", "minimum": 0 },
            "outcomes": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "evidence_analysis": {
      "type": "object",
      "required": ["supporting", "missing", "contradictory", "confidenceExplanation"],
      "properties": {
        "supporting": { "$ref": "#/definitions/evidenceItemList" },
        "missing": { "$ref": "#/definitions/evidenceItemList" },
        "contradictory": { "$ref": "#/definitions/evidenceItemList" },
        "confidenceExplanation": { "type": "string" }
      }
    },
    "evidence_letter": {
      "type": "string",
      "minLength": 50,
      "description": "Formal evidence letter to the payment processor's dispute team (LLM-drafted, or a templated fallback)"
    }
  },
  "definitions": {
    "evidenceItemList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label"],
        "properties": {
          "label": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    }
  }
}
